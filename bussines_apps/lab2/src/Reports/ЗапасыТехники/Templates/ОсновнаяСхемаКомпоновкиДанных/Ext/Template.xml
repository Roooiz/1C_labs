			<field>КоличествоОстаток</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ТоварыНаСкладеОстатки.Номенклатура КАК Номенклатура,
	ТоварыНаСкладеОстатки.Характеристики КАК Характеристики,
	ТоварыНаСкладеОстатки.КоличествоОстаток КАК КоличествоОстаток
ИЗ
	РегистрНакопления.ТоварыНаСкладе.Остатки(&amp;Период, ) КАК ТоварыНаСкладеОстатки,
	РегистрСведений.ЗначенияХарактеристик КАК ЗначенияХарактеристик
{ГДЕ
	(ТоварыНаСкладеОстатки.Номенклатура.Ссылка = ЗначенияХарактеристик.Характеристика.Владелец.Ссылка
			И ЗначенияХарактеристик.Свойство = &amp;Свойство
			И ЗначенияХарактеристик.Значение = &amp;Значение) }

СГРУППИРОВАТЬ ПО
	ТоварыНаСкладеОстатки.Номенклатура,
	ТоварыНаСкладеОстатки.Характеристики,
	ТоварыНаСкладеОстатки.КоличествоОстаток</query>
	</dataSet>
