Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗаказПокупателя) Тогда
		Сообщить("Расходная накладная может быть оформлена только на основании заказа покупателя!", СтатусСообщения.Внимание);
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	Если Не ЗначениеЗаполнено(ЗаказПокупателя) Тогда
		Сообщить("Не указан заказ покупателя — проведение запрещено.", СтатусСообщения.Внимание);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Сообщить("Не указан склад отгрузки.", СтатусСообщения.Внимание);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.РезервыТоваров.Записывать = Истина;
	
	ТаблицаПотребности = Новый ТаблицаЗначений;
	ТаблицаПотребности.Колонки.Add("Товар", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаПотребности.Колонки.Add("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
	
	Для Каждого СтрокаТЧ Из Товары Цикл
		Если СтрокаТЧ.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		НайденнаяСтрока = ТаблицаПотребности.Найти(СтрокаТЧ.Товар, "Товар");
		Если НайденнаяСтрока = Неопределено Тогда
			НоваяСтрока = ТаблицаПотребности.Добавить();
			НоваяСтрока.Товар = СтрокаТЧ.Товар;
			НоваяСтрока.Количество = СтрокаТЧ.Количество;
		Иначе
			НайденнаяСтрока.Количество = НайденнаяСтрока.Количество + СтрокаТЧ.Количество;
		КонецЕсли;
	КонецЦикла;
	
	Если ТаблицаПотребности.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СписокТоваров = ТаблицаПотребности.ВыгрузитьКолонку("Товар");
	
	ЗапросСклад = Новый Запрос;
	ЗапросСклад.Текст = 
	"ВЫБРАТЬ
	|	ОстаткиТоваров.Товар КАК Товар,
	|	ОстаткиТоваров.Склад КАК Склад,
	|	СУММА(ОстаткиТоваров.КоличествоОстаток) КАК Количество,
	|	СУММА(ОстаткиТоваров.СуммаОстаток) КАК Сумма
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(&Дата, Товар В (&СписокТоваров)) КАК ОстаткиТоваров
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиТоваров.Товар,
	|	ОстаткиТоваров.Склад";
	ЗапросСклад.УстановитьПараметр("Дата", МоментВремени());
	ЗапросСклад.УстановитьПараметр("СписокТоваров", СписокТоваров);
	ТЗОстаткиСклад = ЗапросСклад.Выполнить().Выгрузить();
	
	ЗапросРезерв = Новый Запрос;
	ЗапросРезерв.Текст = 
	"ВЫБРАТЬ
	|	РезервыТоваров.Товар КАК Товар,
	|	СУММА(РезервыТоваров.КоличествоОстаток) КАК РезервДругих
	|ИЗ
	|	РегистрНакопления.РезервыТоваров.Остатки(&Дата, Товар В (&СписокТоваров) И Заказ <> &ТекущийЗаказ) КАК РезервыТоваров
	|СГРУППИРОВАТЬ ПО
	|	РезервыТоваров.Товар";
	ЗапросРезерв.УстановитьПараметр("Дата", МоментВремени());
	ЗапросРезерв.УстановитьПараметр("СписокТоваров", СписокТоваров);
	ЗапросРезерв.УстановитьПараметр("ТекущийЗаказ", ЗаказПокупателя);
	ТЗРезервДругих = ЗапросРезерв.Выполнить().Выгрузить();
	
	ЗапросРезервЗаказа = Новый Запрос;
	ЗапросРезервЗаказа.Текст = 
	"ВЫБРАТЬ
	|	РезервыТоваров.Товар КАК Товар,
	|	СУММА(РезервыТоваров.КоличествоОстаток) КАК РезервЗаказа
	|ИЗ
	|	РегистрНакопления.РезервыТоваров.Остатки(&Дата, Товар В (&СписокТоваров) И Заказ = &ТекущийЗаказ) КАК РезервыТоваров
	|СГРУППИРОВАТЬ ПО
	|	РезервыТоваров.Товар";
	ЗапросРезервЗаказа.УстановитьПараметр("Дата", МоментВремени());
	ЗапросРезервЗаказа.УстановитьПараметр("СписокТоваров", СписокТоваров);
	ЗапросРезервЗаказа.УстановитьПараметр("ТекущийЗаказ", ЗаказПокупателя);
	ТЗРезервЗаказа = ЗапросРезервЗаказа.Выполнить().Выгрузить();
	
	Для Каждого Потребность Из ТаблицаПотребности Цикл
		ТоварТек = Потребность.Товар;
		НужноКол = Потребность.Количество;
		
		ВсегоНаСкладах = 0;
		КолНаВыбранномСкладе = 0;
		СуммаНаВыбранномСкладе = 0;
		
		Для Каждого СтрСкл Из ТЗОстаткиСклад.НайтиСтроки(Новый Структура("Товар", ТоварТек)) Цикл
			ВсегоНаСкладах = ВсегоНаСкладах + СтрСкл.Количество;
			Если СтрСкл.Склад = Склад Тогда
				КолНаВыбранномСкладе = СтрСкл.Количество;
				СуммаНаВыбранномСкладе = СтрСкл.Сумма;
			КонецЕсли;
		КонецЦикла;
		
		РезервДругих = 0;
		СтрокаРезДругих = ТЗРезервДругих.Найти(ТоварТек, "Товар");
		Если СтрокаРезДругих <> Неопределено Тогда
			РезервДругих = СтрокаРезДругих.РезервДругих;
		КонецЕсли;
		
		СвободныйОстаток = ВсегоНаСкладах - РезервДругих;
		
		Если КолНаВыбранномСкладе < НужноКол Тогда
			Сообщить("Недостаточно товара """ + ТоварТек + """ на складе """ + Склад + """. В наличии: " + КолНаВыбранномСкладе + ", требуется: " + НужноКол + ".", СтатусСообщения.Внимание);
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Если СвободныйОстаток < НужноКол Тогда
			Сообщить("Недостаточно свободного товара """ + ТоварТек + """ (с учетом резервов других заказов). Свободно: " + СвободныйОстаток + ", требуется: " + НужноКол + ".", СтатусСообщения.Внимание);
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		СредняяЦена = ?(КолНаВыбранномСкладе > 0, СуммаНаВыбранномСкладе / КолНаВыбранномСкладе, 0);
		СуммаСписания = Окр(СредняяЦена * НужноКол, 2);
		
		ДвижениеРасход = Движения.ОстаткиТоваров.Добавить();
		ДвижениеРасход.ВидДвижения = ВидДвиженияНакопления.Расход;
		ДвижениеРасход.Период = Дата;
		ДвижениеРасход.Товар = ТоварТек;
		ДвижениеРасход.Склад = Склад;
		ДвижениеРасход.Количество = НужноКол;
		ДвижениеРасход.Сумма = СуммаСписания;
		
		СтрокаРезЗаказа = ТЗРезервЗаказа.Найти(ТоварТек, "Товар");
		Если СтрокаРезЗаказа <> Неопределено И СтрокаРезЗаказа.РезервЗаказа > 0 Тогда
			СнимаемыйРезерв = Мин(СтрокаРезЗаказа.РезервЗаказа, НужноКол);
			ДвижениеРез = Движения.РезервыТоваров.Добавить();
			ДвижениеРез.ВидДвижения = ВидДвиженияНакопления.Расход;
			ДвижениеРез.Период = Дата;
			ДвижениеРез.Товар = ТоварТек;
			ДвижениеРез.Заказ = ЗаказПокупателя;
			ДвижениеРез.Количество = СнимаемыйРезерв;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры