			<dataPath>Товар</dataPath>
			<field>Товар</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ОстаткиТоваров.Товар КАК Товар,
	ОстаткиТоваров.Склад КАК Склад,
	СУММА(ОстаткиТоваров.КоличествоОстаток) КАК КоличествоНаСкладе,
	CAST(0 КАК ЧИСЛО(15, 3)) КАК КоличествоВРезерве
ИЗ
	РегистрНакопления.ОстаткиТоваров.Остатки(&amp;ДатаНаличия, ) КАК ОстаткиТоваров
СГРУППИРОВАТЬ ПО
	ОстаткиТоваров.Товар,
	ОстаткиТоваров.Склад

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	РезервыТоваров.Товар КАК Товар,
	НЕОПРЕДЕЛЕНО КАК Склад,
	0 КАК КоличествоНаСкладе,
	СУММА(РезервыТоваров.КоличествоОстаток) КАК КоличествоВРезерве
ИЗ
	РегистрНакопления.РезервыТоваров.Остатки(&amp;ДатаНаличия, ) КАК РезервыТоваров
СГРУППИРОВАТЬ ПО
	РезервыТоваров.Товар</query>
