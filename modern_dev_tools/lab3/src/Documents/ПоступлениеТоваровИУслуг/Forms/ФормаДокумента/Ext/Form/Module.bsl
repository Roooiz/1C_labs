&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)
    // Строка, которую сейчас редактирует пользователь
    СтрокаТЧ = Элементы.Товары.ТекущиеДанные;
    
    // Проверка, что строка получена
    Если СтрокаТЧ <> Неопределено Тогда
        // Рассчитываем сумму напрямую в этой строке
        СтрокаТЧ.Сумма = СтрокаТЧ.Количество * СтрокаТЧ.Цена;
    КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНаПоступлениеНоменклатураПриИзменении(Элемент)
	
	// 1. Получаем текущую строку табличной части
	СтрокаТЧ = Элементы.Товары.ТекущиеДанные;
	
	Если СтрокаТЧ <> Неопределено И ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда
		
		// 2. Вызываем серверную функцию, чтобы получить цену из справочника
		СтрокаТЧ.Цена = ПолучитьЦенуЗакупкиИзНоменклатуры(СтрокаТЧ.Номенклатура);
		
		// 3. Сразу пересчитываем сумму (если количество уже заполнено)
		СтрокаТЧ.Сумма = СтрокаТЧ.Количество * СтрокаТЧ.Цена;
		
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЦенуЗакупкиИзНоменклатуры(СсылкаНаНоменклатуру)
	
	// На сервере мы имеем право читать реквизиты через точку!
	Возврат СсылкаНаНоменклатуру.ЦенаЗакупки;

КонецФункции