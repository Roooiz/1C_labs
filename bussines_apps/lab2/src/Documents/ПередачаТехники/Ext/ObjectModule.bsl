Процедура ОбработкаПроведения(Отказ, Режим)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПередачаТехникиСписокТехники.Номенклатура КАК Номенклатура,
		|	СУММА(ПередачаТехникиСписокТехники.Количество) КАК Количество,
		|	ПередачаТехникиСписокТехники.Характеристики КАК Характеристики,
		|	ПередачаТехники.РабочееМесто КАК РабочееМесто,
		|	ПередачаТехники.НомерЛицо КАК НомерЛицо
		|ПОМЕСТИТЬ ТабДок
		|ИЗ
		|	Документ.ПередачаТехники.СписокТехники КАК ПередачаТехникиСписокТехники
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПередачаТехники КАК ПередачаТехники
		|		ПО ПередачаТехникиСписокТехники.Ссылка = ПередачаТехники.СписокТехники.Ссылка
		|ГДЕ
		|	ПередачаТехники.СписокТехники.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ПередачаТехникиСписокТехники.Номенклатура,
		|	ПередачаТехникиСписокТехники.Характеристики,
		|	ПередачаТехники.РабочееМесто,
		|	ПередачаТехники.НомерЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТабДок.Номенклатура КАК Номенклатура,
		|	ТабДок.Количество КАК Количество,
		|	ТабДок.Характеристики КАК Характеристики,
		|	ТабДок.РабочееМесто КАК РабочееМесто,
		|	ТабДок.НомерЛицо КАК НомерЛицо,
		|	ЕСТЬNULL(ТехникаВРаботеОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток
		|ИЗ
		|	ТабДок КАК ТабДок
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТехникаВРаботе.Остатки(
		|				&Момент,
		|				(Номенклатура, Характеристики, РабочееМесто, НомерЛицо) В
		|					(ВЫБРАТЬ
		|						ТабДок.Номенклатура КАК Номенклатура,
		|						ТабДок.Характеристики КАК Характеристики,
		|						ТабДок.РабочееМесто КАК РабочееМесто,
		|						ТабДок.НомерЛицо КАК НомерЛицо
		|					ИЗ
		|						ТабДок КАК ТабДок)) КАК ТехникаВРаботеОстатки
		|		ПО ТабДок.Номенклатура = ТехникаВРаботеОстатки.Номенклатура";
	
	Если Режим = РежимПроведенияДокумента.Оперативный Тогда
		Запрос.УстановитьПараметр("Момент", неопределено);
	Иначе
		Запрос.УстановитьПараметр("Момент", МоментВремени());
	КонецЕсли;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Движения.ТехникаВРаботе.Записывать = Истина;
	Пока Выборка.Следующий() Цикл
		// Расход с работы		
		Движение = Движения.ТехникаВРаботе.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Номенклатура = Выборка.Номенклатура;
		Движение.Характеристики = Выборка.Характеристики;
		Движение.РабочееМесто = РабочееМесто;
		Движение.НомерЛицо = НомерЛицо;
		Движение.Количество = Выборка.Количество;
		
		Если Выборка.КоличествоОстаток < Выборка.Количество Тогда
			Отказ = Истина;
			Сообщить("Не хватает товара '" + Выборка.Номенклатура +  "' в количестве "+ (Выборка.Количество-Выборка.КоличествоОстаток));	
		КонецЕсли;
				
		// Приход в работу
		Движение = Движения.ТехникаВРаботе.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Номенклатура = Выборка.Номенклатура;
		Движение.Характеристики = Выборка.Характеристики;
		Движение.РабочееМесто = НовоеРабочееМесто;
		Движение.НомерЛицо = НовоеНомерЛицо;
		Движение.Количество = Выборка.Количество;

		
	КонецЦикла;
	

КонецПроцедуры

