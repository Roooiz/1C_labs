Процедура ОбработкаПроведения(Отказ, Режим)

	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Сообщить("Расходная накладная должна быть оформлена на основании заказа покупателя (не указан Заказ).");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Склад) Тогда
		Сообщить("Не указан склад отгрузки!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	// Собираем потребность по строкам табличной части
	ТаблицаПотребности = Новый ТаблицаЗначений;
	ТаблицаПотребности.Колонки.Добавить("Товар", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаПотребности.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));

	Для Каждого ТекСтрока Из ПереченьНоменклатуры Цикл
		Если Не ЗначениеЗаполнено(ТекСтрока.Номенклатура) Или ТекСтрока.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;

		НайдСтрока = ТаблицаПотребности.Найти(ТекСтрока.Номенклатура, "Товар");
		Если НайдСтрока = Неопределено Тогда
			НоваяСтрока = ТаблицаПотребности.Добавить();
			НоваяСтрока.Товар = ТекСтрока.Номенклатура;
			НоваяСтрока.Количество = ТекСтрока.Количество;
		Иначе
			НайдСтрока.Количество = НайдСтрока.Количество + ТекСтрока.Количество;
		КонецЕсли;
	КонецЦикла;

	Если ТаблицаПотребности.Количество() = 0 Тогда
		Сообщить("В табличной части нет товаров для списания.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	// 1. Остатки на выбранном складе
	ЗапросСклад = Новый Запрос;
	ЗапросСклад.Текст =
		"ВЫБРАТЬ
		|	ОстаткиОстатки.Материал КАК Товар,
		|	ОстаткиОстатки.КоличествоОстаток КАК КолНаСкладе,
		|	ОстаткиОстатки.СтоимостьОстаток КАК СумНаСкладе
		|ИЗ
		|	РегистрНакопления.ОстаткиМатериалов.Остатки(&Дата, Склад = &Склад) КАК ОстаткиОстатки";
	ЗапросСклад.УстановитьПараметр("Дата", Дата);
	ЗапросСклад.УстановитьПараметр("Склад", Склад);
	ТЗСклад = ЗапросСклад.Выполнить().Выгрузить();

	// 2. Суммарные остатки по всем складам
	ЗапросВсего = Новый Запрос;
	ЗапросВсего.Текст =
		"ВЫБРАТЬ
		|	ОстаткиОстатки.Материал КАК Товар,
		|	СУММА(ОстаткиОстатки.КоличествоОстаток) КАК КолВсего
		|ИЗ
		|	РегистрНакопления.ОстаткиМатериалов.Остатки(&Дата, ) КАК ОстаткиОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиОстатки.Материал";
	ЗапросВсего.УстановитьПараметр("Дата", Дата);
	ТЗВсего = ЗапросВсего.Выполнить().Выгрузить();

	// 3. Резервы по другим заказам (кроме текущего)
	ЗапросРезервДругих = Новый Запрос;
	ЗапросРезервДругих.Текст =
		"ВЫБРАТЬ
		|	РезервыОстатки.Товар КАК Товар,
		|	СУММА(РезервыОстатки.КоличествоОстаток) КАК РезервДругих
		|ИЗ
		|	РегистрНакопления.РезервыТоваров.Остатки(&Дата, Заказ <> &Заказ) КАК РезервыОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	РезервыОстатки.Товар";
	ЗапросРезервДругих.УстановитьПараметр("Дата", Дата);
	ЗапросРезервДругих.УстановитьПараметр("Заказ", Заказ);
	ТЗРезервДругих = ЗапросРезервДругих.Выполнить().Выгрузить();

	// 4. Текущий резерв по выбранному заказу
	ЗапросРезервТекЗаказа = Новый Запрос;
	ЗапросРезервТекЗаказа.Текст =
		"ВЫБРАТЬ
		|	РезервыОстатки.Товар КАК Товар,
		|	СУММА(РезервыОстатки.КоличествоОстаток) КАК РезервЗаказа
		|ИЗ
		|	РегистрНакопления.РезервыТоваров.Остатки(&Дата, Заказ = &Заказ) КАК РезервыОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	РезервыОстатки.Товар";
	ЗапросРезервТекЗаказа.УстановитьПараметр("Дата", Дата);
	ЗапросРезервТекЗаказа.УстановитьПараметр("Заказ", Заказ);
	ТЗРезервЗаказа = ЗапросРезервТекЗаказа.Выполнить().Выгрузить();

	// Проверяем наличие на выбранном складе и свободный остаток
	Движения.ОстаткиМатериалов.Записывать = Истина;
	Движения.РезервыТоваров.Записывать = Истина;

	Для Каждого СтрокаПотр Из ТаблицаПотребности Цикл
		Товар = СтрокаПотр.Товар;
		Нужно = СтрокаПотр.Количество;

		КолНаСкладе = 0;
		СумНаСкладе = 0;
		НайдСклад = ТЗСклад.Найти(Товар, "Товар");
		Если НайдСклад <> Неопределено Тогда
			КолНаСкладе = НайдСклад.КолНаСкладе;
			СумНаСкладе = НайдСклад.СумНаСкладе;
		КонецЕсли;

		КолВсего = 0;
		НайдВсего = ТЗВсего.Найти(Товар, "Товар");
		Если НайдВсего <> Неопределено Тогда
			КолВсего = НайдВсего.КолВсего;
		КонецЕсли;

		РезервДругих = 0;
		НайдРезДруг = ТЗРезервДругих.Найти(Товар, "Товар");
		Если НайдРезДруг <> Неопределено Тогда
			РезервДругих = НайдРезДруг.РезервДругих;
		КонецЕсли;

		СвободныйОстаток = КолВсего - РезервДругих;

		Если Нужно > КолНаСкладе Тогда
			Сообщить("Недостаточно товара """ + Строка(Товар) + """ на складе """ + Строка(Склад) + """. Требуется: " + Нужно + ", на складе: " + КолНаСкладе + ".");
			Отказ = Истина;
			Продолжить;
		КонецЕсли;

		Если Нужно > СвободныйОстаток Тогда
			Сообщить("Недостаточно свободного остатка товара """ + Строка(Товар) + """ (с учетом резервов других заказов). Требуется: " + Нужно + ", свободно: " + СвободныйОстаток + ".");
			Отказ = Истина;
			Продолжить;
		КонецЕсли;

		// Средняя себестоимость по складу
		СредняяЦена = ?(КолНаСкладе > 0, СумНаСкладе / КолНаСкладе, 0);
		СуммаСписания = Окр(СредняяЦена * Нужно, 2);

		ДвижениеРасход = Движения.ОстаткиМатериалов.Добавить();
		ДвижениеРасход.ВидДвижения = ВидДвиженияНакопления.Расход;
		ДвижениеРасход.Период = Дата;
		ДвижениеРасход.Склад = Склад;
		ДвижениеРасход.Материал = Товар;
		ДвижениеРасход.Количество = Нужно;
		ДвижениеРасход.Стоимость = СуммаСписания;

		// Снимаем резерв по текущему заказу
		РезервЗаказа = 0;
		НайдРезЗак = ТЗРезервЗаказа.Найти(Товар, "Товар");
		Если НайдРезЗак <> Неопределено Тогда
			РезервЗаказа = НайдРезЗак.РезервЗаказа;
		КонецЕсли;

		СнятьРезерва = Мин(Нужно, РезервЗаказа);
		Если СнятьРезерва > 0 Тогда
			ДвижениеРезерв = Движения.РезервыТоваров.Добавить();
			ДвижениеРезерв.ВидДвижения = ВидДвиженияНакопления.Расход;
			ДвижениеРезерв.Период = Дата;
			ДвижениеРезерв.Заказ = Заказ;
			ДвижениеРезерв.Товар = Товар;
			ДвижениеРезерв.Количество = СнятьРезерва;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры