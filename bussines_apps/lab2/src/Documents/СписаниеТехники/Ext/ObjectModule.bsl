
Процедура ОбработкаПроведения(Отказ, Режим)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СписаниеТехникиСписокТехники.Номенклатура КАК Номенклатура,
		|	СУММА(СписаниеТехникиСписокТехники.Количество) КАК Количество,
		|	СписаниеТехникиСписокТехники.Характеристики КАК Характеристики,
		|	СписаниеТехники.РабочееМесто КАК РабочееМесто,
		|	СписаниеТехники.НомерЛицо КАК НомерЛицо
		|ПОМЕСТИТЬ ТабДок
		|ИЗ
		|	Документ.СписаниеТехники.СписокТехники КАК СписаниеТехникиСписокТехники
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СписаниеТехники КАК СписаниеТехники
		|		ПО СписаниеТехникиСписокТехники.Ссылка = СписаниеТехники.СписокТехники.Ссылка
		|ГДЕ
		|	СписаниеТехники.СписокТехники.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	СписаниеТехникиСписокТехники.Номенклатура,
		|	СписаниеТехникиСписокТехники.Характеристики,
		|	СписаниеТехники.РабочееМесто,
		|	СписаниеТехники.НомерЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТабДок.Номенклатура КАК Номенклатура,
		|	ТабДок.Количество КАК Количество,
		|	ТабДок.Характеристики КАК Характеристики,
		|	ТабДок.РабочееМесто КАК РабочееМесто,
		|	ТабДок.НомерЛицо КАК НомерЛицо,
		|	ЕСТЬNULL(ТехникаВРаботеОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток
		|ИЗ
		|	ТабДок КАК ТабДок
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТехникаВРаботе.Остатки(
		|				&Момент,
		|				(Номенклатура, Характеристики, РабочееМесто, НомерЛицо) В
		|					(ВЫБРАТЬ
		|						ТабДок.Номенклатура КАК Номенклатура,
		|						ТабДок.Характеристики КАК Характеристики,
		|						ТабДок.РабочееМесто КАК РабочееМесто,
		|						ТабДок.НомерЛицо КАК НомерЛицо
		|					ИЗ
		|						ТабДок КАК ТабДок)) КАК ТехникаВРаботеОстатки
		|		ПО ТабДок.Номенклатура = ТехникаВРаботеОстатки.Номенклатура";
	
	Если Режим = РежимПроведенияДокумента.Оперативный Тогда
		Запрос.УстановитьПараметр("Момент", неопределено);
	Иначе
		Запрос.УстановитьПараметр("Момент", МоментВремени());
	КонецЕсли;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Движения.ТехникаВРаботе.Записывать = Истина;
	Движения.СписаннаяТехника.Записывать = Истина;
	Пока Выборка.Следующий() Цикл
		// Расход с работы
		Движение = Движения.ТехникаВРаботе.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Номенклатура = Выборка.Номенклатура;
		Движение.Характеристики = Выборка.Характеристики;
		Движение.РабочееМесто = РабочееМесто;
		Движение.НомерЛицо = НомерЛицо;
		Движение.Количество = Выборка.Количество;
		
		Если Выборка.КоличествоОстаток < Выборка.Количество Тогда
			Отказ = Истина;
			Сообщить("Не хватает товара '" + Выборка.Номенклатура +  "' в количестве "+ (Выборка.Количество-Выборка.КоличествоОстаток));	
		КонецЕсли;	
		
		// Приход в списание
		Движение = Движения.СписаннаяТехника.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Номенклатура = Выборка.Номенклатура;
		Движение.Характеристики = Выборка.Характеристики;
		Движение.Количество = Выборка.Количество;
		
	КонецЦикла;

КонецПроцедуры
