					<v8:lang>ru</v8:lang>
					<v8:content>В ремонте</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ТоварыНаСкладеОстатки.Номенклатура КАК Номенклатура,
	ТоварыНаСкладеОстатки.КоличествоОстаток КАК НаСкладе,
	ЕСТЬNULL(ТехникаВРаботеОстатки.КоличествоОстаток, 0) КАК ВРаботе,
	ЕСТЬNULL(СписаннаяТехникаОстатки.КоличествоОстаток, 0) КАК Списано,
	ЕСТЬNULL(ТехникаВРемонтеОстатки.КоличествоОстаток, 0) КАК ВРемонте
ИЗ
	РегистрНакопления.ТоварыНаСкладе.Остатки(&amp;Период, ) КАК ТоварыНаСкладеОстатки
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТехникаВРаботе.Остатки КАК ТехникаВРаботеОстатки
		ПО (ТоварыНаСкладеОстатки.Номенклатура.Ссылка = ТехникаВРаботеОстатки.Номенклатура.Ссылка)
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.СписаннаяТехника.Остатки КАК СписаннаяТехникаОстатки
		ПО (ТоварыНаСкладеОстатки.Номенклатура.Ссылка = СписаннаяТехникаОстатки.Номенклатура.Ссылка)
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТехникаВРемонте.Остатки КАК ТехникаВРемонтеОстатки
		ПО (ТоварыНаСкладеОстатки.Номенклатура.Ссылка = ТехникаВРемонтеОстатки.Номенклатура.Ссылка),
	РегистрСведений.ЗначенияХарактеристик КАК ЗначенияХарактеристик
{ГДЕ
	ЗначенияХарактеристик.Свойство = &amp;Свойство
	И ЗначенияХарактеристик.Значение = &amp;Значение
	И ЗначенияХарактеристик.Характеристика.Владелец.Ссылка = ТоварыНаСкладеОстатки.Номенклатура.Ссылка}

СГРУППИРОВАТЬ ПО
	ТоварыНаСкладеОстатки.Номенклатура,
	ТоварыНаСкладеОстатки.КоличествоОстаток,
	ЕСТЬNULL(ТехникаВРаботеОстатки.КоличествоОстаток, 0),
	ЕСТЬNULL(СписаннаяТехникаОстатки.КоличествоОстаток, 0),
	ЕСТЬNULL(ТехникаВРемонтеОстатки.КоличествоОстаток, 0)</query>
	</dataSet>
