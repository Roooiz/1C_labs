&НаСервереБезКонтекста
функция ПолучитьСотрудника(Цех,Дата)
	МастерВЦехе  = РегистрыСведений.МастерВЦехе;
	Фильтр   = Новый Структура;
	Фильтр.Вставить("ВидРемонта",Цех);
	Фильтр.Вставить("ДеньРаботы", Дата);
	Таб = МастерВЦехе.Получить(Дата,Фильтр);
	Возврат Таб.Мастер();
