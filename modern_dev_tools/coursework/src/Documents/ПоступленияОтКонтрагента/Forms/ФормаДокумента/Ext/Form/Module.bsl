
&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	СтрокаТабличнойЧасти = Элементы.Данные.ТекущиеДанные;
	//если СтрокаТабличнойЧасти = 0 тогда 
		// обязательно требуется сначала ввести строку, затем сохранить документ, потом выбрать контрагента, иначе ошибка :-(
	СтрокаТабличнойЧасти.Сумма = ПолучитьДолг(Объект.Контрагент, Объект.Дата);
КонецПроцедуры

&НаСервереБезКонтекста
функция ПолучитьДолг(Контрагент,Дата)
	ДолгиКонтрагентов  = РегистрыНакопления.ДолгиКонтрагентов;
	Фильтр   = Новый Структура;
	Фильтр.Вставить("Контрагент",Контрагент);
	ТабОстатков = ДолгиКонтрагентов.Остатки(Дата,Фильтр,"Контрагент", "Сумма");
//	Если ТабОстатков.Сумма()>0 тогда
	Если ТабОстатков.Итог("Сумма")<0 тогда
	//Возврат ТабОстатков.Итог("Сумма");
	Возврат ТабОстатков.Итог("Сумма")*-1;
	//Возврат Табостатков.Сумма();
	Иначе Возврат 0;
	КонецЕсли;
	//Возврат Количество.ОстаткиМатериалов(Дата, Номенклатура, Склад);
КонецФункции
