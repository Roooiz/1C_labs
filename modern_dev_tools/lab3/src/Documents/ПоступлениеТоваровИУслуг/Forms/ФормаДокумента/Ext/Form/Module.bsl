&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)
    // Строка, которую сейчас редактирует пользователь
    СтрокаТЧ = Элементы.Товары.ТекущиеДанные;
    
    // Проверка, что строка получена
    Если СтрокаТЧ <> Неопределено Тогда
        // Рассчитываем сумму напрямую в этой строке
        СтрокаТЧ.Сумма = СтрокаТЧ.Количество * СтрокаТЧ.Цена;
    КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
    СтрокаТЧ = Элементы.Товары.ТекущиеДанные;
    
    Если СтрокаТЧ <> Неопределено И СтрокаТЧ.Номенклатура <> Неопределено Тогда
        // Отладочное сообщение — покажет, что видит код
        Сообщение = "Номенклатура: " + СтрокаТЧ.Номенклатура + Символы.ПС 
                    + "ЦенаЗакупки: " + СтрокаТЧ.Номенклатура.ЦенаЗакупки;
        ПоказатьПредупреждение(, Сообщение);
        
        СтрокаТЧ.Цена = СтрокаТЧ.Номенклатура.ЦенаЗакупки;
        СтрокаТЧ.Сумма = СтрокаТЧ.Количество * СтрокаТЧ.Цена;
    КонецЕсли;
КонецПроцедуры