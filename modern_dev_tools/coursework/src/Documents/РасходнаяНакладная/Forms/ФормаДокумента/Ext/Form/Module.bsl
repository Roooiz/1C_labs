&НаСервереБезКонтекста
функция ПолучитьОстатки(Номенклатура,Склад,Дата)
	ОстаткиМатериалов  = РегистрыНакопления.ОстаткиМатериалов;
	Фильтр   = Новый Структура;
	Фильтр.Вставить("Материал",Номенклатура);
	Фильтр.Вставить("Склад", Склад);
	ТабОстатков = ОстаткиМатериалов.Остатки(Дата,Фильтр,"Материал,Склад", "Количество");
	Возврат ТабОстатков.Количество();
