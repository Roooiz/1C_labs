Процедура ОбработкаПроведения(Отказ, Режим)

	Для Каждого ТекСтрока Из Товары Цикл
		Если ТекСтрока.Резерв > ТекСтрока.Количество Тогда
			Сообщить("По товару """ + Строка(ТекСтрока.Товар) + """ резерв (" + ТекСтрока.Резерв + ") не может превышать заказанное количество (" + ТекСтрока.Количество + ").");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Движения.РезервыТоваров.Записывать = Истина;

	Для Каждого ТекСтрока Из Товары Цикл
		Если Не ЗначениеЗаполнено(ТекСтрока.Товар) Или ТекСтрока.Резерв <= 0 Тогда
			Продолжить;
		КонецЕсли;

		Движение = Движения.РезервыТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Заказ = Ссылка;
		Движение.Товар = ТекСтрока.Товар;
		Движение.Количество = ТекСтрока.Резерв;
	КонецЦикла;

КонецПроцедуры